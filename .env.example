# ── rgaccount front end ──────────────────────────────────────────────
# Copy to .env for local work. Vite only exposes VITE_-prefixed values to
# the browser, so treat every value here as public — never put a secret in
# this file or in any variable the front end reads.

# Where the API lives.
VITE_API_URL=http://35.153.68.247

# ── Console split (optional) ─────────────────────────────────────────
# Set this on the MARKETING deployment only, and Sign in / Create account
# become full cross-origin navigations to the console instead of in-app
# routes. Leave it unset for local work, for previews, and on the console
# deployment itself — the links then stay client-side routes, which is
# what keeps a single-origin deploy working unchanged.
#
# Set it to an origin with no trailing path:
#   VITE_CONSOLE_URL=https://console.mountreality.com
# VITE_CONSOLE_URL=
