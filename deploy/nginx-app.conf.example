# Replace app.example.com and the root path before enabling this file.
# The GitHub workflow atomically updates the `current` symlink.

server {
    listen 80;
    listen [::]:80;
    server_name app.example.com;

    root /var/www/mountreality-frontend/current;
    index index.html;

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location ~* \.(?:css|js|mjs|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
